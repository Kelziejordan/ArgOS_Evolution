# Firebase Configuration
# These are retrieved from your firebase-applet-config.json after running the set_up_firebase tool.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Kraken API (Optional for Paper Trading, required for Live)
KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_secret_key_here

# Boot Configuration (Safety Defaults)
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ENV=false
DRY_RUN_MODE=true

# AI / Neural Processor
GEMINI_API_KEY=

# Production & Deployment Orchestration
NODE_ENV=production
FIRESTORE_PROJECT_ID=

